<%- include('partials/header') %>

<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-3xl p-8 sm:p-10 shadow-2xl border border-slate-200/80 dark:border-slate-800 transition-all">
    
    <!-- Logo & Header -->
    <div class="text-center mb-8">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-slate-900 to-indigo-900 mx-auto flex items-center justify-center text-white shadow-lg shadow-indigo-500/20 mb-4 border border-indigo-500/30">
        <i data-lucide="shield-check" class="w-7 h-7 text-indigo-400"></i>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Admin Management Portal</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Authorized store personnel only</p>
    </div>

    <!-- Error Alerts -->
    <% if (errors && errors.length > 0) { %>
      <div class="mb-6 p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-sm">
        <div class="flex items-center gap-2 font-semibold mb-1">
          <i data-lucide="alert-circle" class="w-4 h-4"></i>
          <span>Access Denied:</span>
        </div>
        <ul class="list-disc list-inside space-y-1 text-xs">
          <% errors.forEach(err => { %>
            <li><%= err.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Demo Admin Helper Tile -->
    <div class="mb-6 p-4 rounded-2xl bg-indigo-50/70 dark:bg-indigo-950/40 border border-indigo-100 dark:border-indigo-900/60">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-indigo-900 dark:text-indigo-200 flex items-center gap-1.5">
          <i data-lucide="key" class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400"></i>
          Pre-registered Demo Admin
        </span>
        <span class="text-[10px] text-indigo-600 dark:text-indigo-400 font-medium">Ready to use</span>
      </div>
      <p class="text-xs text-indigo-700/80 dark:text-indigo-300/80 font-mono mb-3">admin@shopsphere.com / Admin@123</p>

      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          onclick="fillDemoAdmin()"
          class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-700 text-xs font-semibold hover:bg-indigo-50 transition-colors shadow-sm"
        >
          Auto-fill Details
        </button>
        <a
          href="/quick-login?role=admin"
          class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-indigo-600 dark:hover:bg-indigo-700 text-white text-xs font-semibold transition-all shadow-md flex items-center gap-1.5"
        >
          <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-400"></i>
          <span>1-Click Sign In as Admin</span>
        </a>
      </div>
    </div>

    <!-- Login Form -->
    <form action="/admin/login" method="POST" id="admin-login-form" class="space-y-5">
      <input type="hidden" name="sid" value="<%= typeof sid !== 'undefined' ? sid : '' %>">
      <div>
        <label for="admin-email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">Admin Email</label>
        <div class="relative">
          <input
            type="email"
            id="admin-email"
            name="email"
            autocomplete="email"
            required
            value="<%= typeof email !== 'undefined' ? email : '' %>"
            placeholder="admin@shopsphere.com"
            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"
          />
          <i data-lucide="mail" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
        </div>
      </div>

      <div>
        <label for="admin-password" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">Password</label>
        <div class="relative">
          <input
            type="password"
            id="admin-password"
            name="password"
            autocomplete="current-password"
            required
            placeholder="••••••••"
            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"
          />
          <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
        </div>
      </div>

      <button
        type="submit"
        class="w-full py-3 px-4 rounded-xl font-semibold text-sm text-white bg-slate-900 hover:bg-slate-800 dark:bg-indigo-600 dark:hover:bg-indigo-700 active:scale-[0.99] shadow-lg shadow-slate-900/25 transition-all flex items-center justify-center gap-2"
      >
        <i data-lucide="shield" class="w-4 h-4"></i>
        <span>Sign In as Admin</span>
      </button>
    </form>

    <!-- Registration Link -->
    <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 text-center space-y-2">
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Need to register a new administrator?
        <a href="/admin/register" class="font-semibold text-indigo-600 dark:text-indigo-400 hover:underline ml-1">Create Admin Account</a>
      </p>
      <div>
        <a href="/login" class="text-[11px] text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors">
          ← Return to Customer Store Login
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  function fillDemoAdmin() {
    const emailEl = document.getElementById('admin-email');
    const pwdEl = document.getElementById('admin-password');
    if (emailEl) emailEl.value = 'admin@shopsphere.com';
    if (pwdEl) pwdEl.value = 'Admin@123';
    try {
      if (typeof showToast === 'function') showToast('Filled demo admin credentials!', 'info');
    } catch (e) {}
  }

  function fillAndSubmitDemoAdmin() {
    fillDemoAdmin();
    setTimeout(() => {
      const form = document.getElementById('admin-login-form');
      if (form) {
        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
        } else {
          form.submit();
        }
      }
    }, 150);
  }
</script>

<%- include('partials/footer') %>
