<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">

  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
    <a href="/dashboard" class="hover:text-indigo-600 dark:hover:text-indigo-400">Store</a>
    <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
    <a href="/dashboard?category=<%= encodeURIComponent(product.category) %>" class="hover:text-indigo-600 dark:hover:text-indigo-400"><%= product.category %></a>
    <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
    <span class="text-slate-900 dark:text-slate-200 font-medium truncate max-w-xs"><%= product.name %></span>
  </nav>

  <!-- Product Hero Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 bg-white dark:bg-slate-900 p-6 sm:p-10 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
    
    <!-- Image Gallery -->
    <div class="space-y-4">
      <div class="aspect-square rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-800 relative group">
        <img
          id="main-product-img"
          src="<%= product.image_url %>"
          alt="<%= product.name %>"
          class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&q=80';"
        />

        <% if (product.stock === 0) { %>
          <div class="absolute top-4 right-4 bg-rose-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-md">
            Out of Stock
          </div>
        <% } else if (product.stock <= 5) { %>
          <div class="absolute top-4 right-4 bg-amber-500 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-md animate-pulse">
            Only <%= product.stock %> Left!
          </div>
        <% } %>
      </div>

      <!-- Thumbnail Strip -->
      <div class="flex items-center gap-3">
        <button
          type="button"
          onclick="document.getElementById('main-product-img').src='<%= product.image_url %>'"
          class="w-16 h-16 rounded-xl overflow-hidden border-2 border-indigo-600 p-0.5"
        >
          <img src="<%= product.image_url %>" alt="Thumbnail" class="w-full h-full object-cover rounded-lg" />
        </button>
      </div>
    </div>

    <!-- Product Info & Actions -->
    <div class="flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <!-- Category & Rating -->
        <div class="flex items-center justify-between">
          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-100 dark:border-indigo-900">
            <%= product.category %>
          </span>
          <div class="flex items-center gap-1.5 text-xs font-bold text-slate-700 dark:text-slate-200 bg-amber-50 dark:bg-amber-950/50 px-2.5 py-1 rounded-lg border border-amber-200 dark:border-amber-800">
            <i data-lucide="star" class="w-3.5 h-3.5 text-amber-500 fill-amber-500"></i>
            <span><%= Number(product.rating || 4.5).toFixed(1) %></span>
            <span class="text-slate-400 font-normal">(Verified Ratings)</span>
          </div>
        </div>

        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          <%= product.name %>
        </h1>

        <!-- Price Section -->
        <div class="flex items-baseline gap-3 pt-1">
          <span class="text-3xl font-extrabold text-slate-900 dark:text-white">
            <%= formatPrice(product.price) %>
          </span>
          <span class="text-sm text-slate-400 line-through">
            <%= formatPrice(product.price * 1.25) %>
          </span>
          <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950 px-2 py-0.5 rounded-md">
            20% OFF
          </span>
        </div>

        <!-- Stock Status Bar -->
        <div class="pt-2">
          <% if (product.stock > 5) { %>
            <div class="flex items-center gap-2 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>In Stock (<%= product.stock %> units available) • Ready for Cash on Delivery</span>
            </div>
          <% } else if (product.stock > 0) { %>
            <div class="flex items-center gap-2 text-xs font-semibold text-amber-600 dark:text-amber-400">
              <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
              <span>Low Stock: Only <%= product.stock %> units remaining!</span>
            </div>
          <% } else { %>
            <div class="flex items-center gap-2 text-xs font-semibold text-rose-600 dark:text-rose-400">
              <span class="w-2 h-2 rounded-full bg-rose-500"></span>
              <span>Currently Out of Stock</span>
            </div>
          <% } %>
        </div>

        <!-- Description -->
        <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Description</h4>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            <%= product.description %>
          </p>
        </div>

        <!-- Cash on Delivery Trust Box -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/80 space-y-2 text-xs">
          <div class="flex items-center gap-2 text-slate-800 dark:text-slate-200 font-semibold">
            <i data-lucide="banknote" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
            <span>Pay on Delivery with Cash or UPI</span>
          </div>
          <div class="flex items-center gap-2 text-slate-600 dark:text-slate-400">
            <i data-lucide="truck" class="w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
            <span>Delivered in 3 to 5 business days</span>
          </div>
          <div class="flex items-center gap-2 text-slate-600 dark:text-slate-400">
            <i data-lucide="shield-check" class="w-4 h-4 text-amber-500"></i>
            <span>7-Day Easy doorstep replacement guarantee</span>
          </div>
        </div>
      </div>

      <!-- Purchase Controls -->
      <div class="space-y-4 pt-4 border-t border-slate-100 dark:border-slate-800">
        <% if (product.stock > 0) { %>
          <div class="flex items-center gap-4">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">Quantity</label>
            <div class="flex items-center border border-slate-300 dark:border-slate-700 rounded-xl bg-slate-50 dark:bg-slate-800 p-1">
              <button
                type="button"
                onclick="const el = document.getElementById('product-qty'); if(el.value > 1) el.value--;"
                class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-700 transition-colors font-bold"
              >
                -
              </button>
              <input
                type="number"
                id="product-qty"
                value="1"
                min="1"
                max="<%= product.stock %>"
                readonly
                class="w-12 text-center text-sm font-bold bg-transparent border-none focus:outline-none text-slate-900 dark:text-white"
              />
              <button
                type="button"
                onclick="const el = document.getElementById('product-qty'); if(Number(el.value) < <%= product.stock %>) el.value++;"
                class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-700 transition-colors font-bold"
              >
                +
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            <button
              type="button"
              onclick="addToCart(<%= product.id %>, Number(document.getElementById('product-qty').value), this)"
              class="py-3 px-6 rounded-2xl font-semibold text-sm text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/80 hover:bg-indigo-100 dark:hover:bg-indigo-900 border border-indigo-200 dark:border-indigo-800 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <i data-lucide="shopping-cart" class="w-4 h-4"></i>
              <span>Add to Cart</span>
            </button>

            <button
              type="button"
              onclick="buyNow(<%= product.id %>)"
              class="py-3 px-6 rounded-2xl font-semibold text-sm text-white bg-indigo-600 hover:bg-indigo-700 active:scale-[0.98] shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <i data-lucide="zap" class="w-4 h-4"></i>
              <span>Buy Now (COD)</span>
            </button>
          </div>
        <% } else { %>
          <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-sm font-semibold text-center">
            This item is currently sold out. Please check back later.
          </div>
        <% } %>
      </div>

    </div>

  </div>

  <!-- Related Products -->
  <% if (relatedProducts && relatedProducts.length > 0) { %>
    <div class="space-y-4 pt-6">
      <div class="flex items-center justify-between">
        <h3 class="text-xl font-bold text-slate-900 dark:text-white">Related in <%= product.category %></h3>
        <a href="/dashboard?category=<%= encodeURIComponent(product.category) %>" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">
          View all →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% relatedProducts.forEach(rel => { %>
          <div class="product-card group flex flex-col bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-lg transition-all">
            <a href="/product/<%= rel.id %>" class="block aspect-square overflow-hidden bg-slate-100 dark:bg-slate-800 relative">
              <img
                src="<%= rel.image_url %>"
                alt="<%= rel.name %>"
                class="product-card-img w-full h-full object-cover"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&q=80';"
              />
              <div class="absolute bottom-2 left-2 bg-black/60 text-white px-2 py-0.5 rounded text-[10px] flex items-center gap-1 font-semibold">
                <i data-lucide="star" class="w-3 h-3 text-amber-400 fill-amber-400"></i>
                <span><%= Number(rel.rating || 4.5).toFixed(1) %></span>
              </div>
            </a>
            <div class="p-3.5 flex-1 flex flex-col justify-between">
              <div>
                <a href="/product/<%= rel.id %>" class="text-xs font-semibold text-slate-900 dark:text-white hover:text-indigo-600 line-clamp-1">
                  <%= rel.name %>
                </a>
              </div>
              <div class="mt-2 flex items-center justify-between">
                <span class="text-sm font-bold text-slate-900 dark:text-white"><%= formatPrice(rel.price) %></span>
                <% if (rel.stock > 0) { %>
                  <button
                    type="button"
                    onclick="addToCart(<%= rel.id %>, 1, this)"
                    class="p-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-600 hover:text-white transition-colors"
                  >
                    <i data-lucide="plus" class="w-4 h-4"></i>
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

</div>

<script>
  async function buyNow(productId) {
    const qty = Number(document.getElementById('product-qty').value) || 1;
    try {
      const res = await fetch('/api/cart/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId, quantity: qty })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.href = '/checkout';
      } else {
        showToast(data.message || 'Could not proceed to checkout.', 'error');
      }
    } catch (e) {
      showToast('Error proceeding to checkout.', 'error');
    }
  }
</script>

<%- include('partials/footer') %>
