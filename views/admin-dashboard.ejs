<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">

  <!-- Welcome Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Store Overview & Operations</h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">Real-time stats, inventory, and order dispatch control</p>
    </div>
    <div class="flex items-center gap-3">
      <a
        href="/admin/add-product"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs sm:text-sm shadow-md shadow-indigo-600/25 transition-all"
      >
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
        <span>Add New Product</span>
      </a>
    </div>
  </div>

  <!-- 4 Stat Cards (Gradient design) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    
    <!-- Products Stat -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm flex items-center justify-between">
      <div>
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Total Products</span>
        <span class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1 block"><%= stats.totalProducts %></span>
        <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium mt-1 inline-flex items-center gap-1">
          <i data-lucide="package-check" class="w-3 h-3"></i>
          Active in Catalog
        </span>
      </div>
      <div class="w-14 h-14 rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
        <i data-lucide="package" class="w-7 h-7"></i>
      </div>
    </div>

    <!-- Customers Stat -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm flex items-center justify-between">
      <div>
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Customers</span>
        <span class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1 block"><%= stats.totalCustomers %></span>
        <span class="text-[11px] text-indigo-600 dark:text-indigo-400 font-medium mt-1 inline-flex items-center gap-1">
          <i data-lucide="users" class="w-3 h-3"></i>
          Registered Users
        </span>
      </div>
      <div class="w-14 h-14 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
        <i data-lucide="users" class="w-7 h-7"></i>
      </div>
    </div>

    <!-- Orders Stat -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm flex items-center justify-between">
      <div>
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Total Orders</span>
        <span class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1 block"><%= stats.totalOrders %></span>
        <span class="text-[11px] text-amber-600 dark:text-amber-400 font-medium mt-1 inline-flex items-center gap-1">
          <i data-lucide="shopping-bag" class="w-3 h-3"></i>
          COD Bookings
        </span>
      </div>
      <div class="w-14 h-14 rounded-2xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center">
        <i data-lucide="truck" class="w-7 h-7"></i>
      </div>
    </div>

    <!-- Revenue Stat -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm flex items-center justify-between">
      <div>
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Gross Revenue</span>
        <span class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1 block"><%= formatPrice(stats.totalRevenue) %></span>
        <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium mt-1 inline-flex items-center gap-1">
          <i data-lucide="banknote" class="w-3 h-3"></i>
          Excludes Cancelled
        </span>
      </div>
      <div class="w-14 h-14 rounded-2xl bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center">
        <i data-lucide="wallet" class="w-7 h-7"></i>
      </div>
    </div>

  </div>

  <!-- 3 Big Action Tiles -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <a
      href="/admin/add-product"
      class="group p-6 rounded-3xl bg-gradient-to-br from-indigo-500 to-indigo-700 text-white shadow-lg hover:shadow-indigo-500/25 transition-all flex items-center gap-5"
    >
      <div class="w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center text-white flex-shrink-0 group-hover:scale-110 transition-transform">
        <i data-lucide="plus" class="w-6 h-6"></i>
      </div>
      <div>
        <h3 class="font-bold text-base">Add New Product</h3>
        <p class="text-xs text-indigo-100 mt-0.5">Upload new inventory, set pricing & stock</p>
      </div>
    </a>

    <a
      href="/admin/orders"
      class="group p-6 rounded-3xl bg-gradient-to-br from-amber-500 to-amber-600 text-white shadow-lg hover:shadow-amber-500/25 transition-all flex items-center gap-5"
    >
      <div class="w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center text-white flex-shrink-0 group-hover:scale-110 transition-transform">
        <i data-lucide="truck" class="w-6 h-6"></i>
      </div>
      <div>
        <h3 class="font-bold text-base">Manage Orders</h3>
        <p class="text-xs text-amber-100 mt-0.5">Update fulfillment (Placed → Shipped → Delivered)</p>
      </div>
    </a>

    <a
      href="/admin/customers"
      class="group p-6 rounded-3xl bg-gradient-to-br from-emerald-500 to-emerald-700 text-white shadow-lg hover:shadow-emerald-500/25 transition-all flex items-center gap-5"
    >
      <div class="w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center text-white flex-shrink-0 group-hover:scale-110 transition-transform">
        <i data-lucide="user-check" class="w-6 h-6"></i>
      </div>
      <div>
        <h3 class="font-bold text-base">View Customers</h3>
        <p class="text-xs text-emerald-100 mt-0.5">Customer registry, order count & spend history</p>
      </div>
    </a>
  </div>

  <!-- Recent Orders Mini-Table -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <i data-lucide="clock" class="w-5 h-5 text-indigo-600"></i>
        <span>Recent Orders</span>
      </h3>
      <a href="/admin/orders" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">
        View All Orders →
      </a>
    </div>

    <% if (recentOrders.length === 0) { %>
      <div class="p-8 text-center text-sm text-slate-400">No orders placed yet.</div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-600 dark:text-slate-300">
          <thead class="bg-slate-50 dark:bg-slate-800/60 uppercase font-semibold text-slate-400 border-b border-slate-200 dark:border-slate-700">
            <tr>
              <th class="p-3">Order ID</th>
              <th class="p-3">Customer</th>
              <th class="p-3">Total</th>
              <th class="p-3">Date</th>
              <th class="p-3">Status</th>
              <th class="p-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            <% recentOrders.forEach(ord => { %>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
                <td class="p-3 font-bold text-slate-900 dark:text-white">#<%= ord.id %></td>
                <td class="p-3 font-medium text-slate-800 dark:text-slate-200">
                  <%= ord.customer_name %>
                  <span class="block text-[10px] text-slate-400"><%= ord.customer_email %></span>
                </td>
                <td class="p-3 font-semibold text-slate-900 dark:text-white"><%= formatPrice(ord.total) %></td>
                <td class="p-3 text-slate-400"><%= new Date(ord.created_at).toLocaleDateString('en-IN') %></td>
                <td class="p-3">
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-bold <%= 
                    ord.status === 'Placed' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300' :
                    ord.status === 'Shipped' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300' :
                    ord.status === 'Delivered' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300' :
                    'bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-300'
                  %>">
                    <%= ord.status %>
                  </span>
                </td>
                <td class="p-3 text-right">
                  <a href="/admin/orders" class="text-indigo-600 dark:text-indigo-400 font-semibold hover:underline">
                    Manage
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Product Catalog Management Table -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <i data-lucide="boxes" class="w-5 h-5 text-indigo-600"></i>
          <span>Product Catalog Inventory</span>
        </h3>
        <p class="text-xs text-slate-400 mt-0.5">Edit pricing, adjust stock, or remove products</p>
      </div>

      <a
        href="/admin/add-product"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-semibold text-xs hover:bg-indigo-100 transition-colors"
      >
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        <span>Add Product</span>
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600 dark:text-slate-300">
        <thead class="bg-slate-50 dark:bg-slate-800/60 uppercase font-semibold text-slate-400 border-b border-slate-200 dark:border-slate-700">
          <tr>
            <th class="p-3">Product</th>
            <th class="p-3">Category</th>
            <th class="p-3">Price</th>
            <th class="p-3">Stock Units</th>
            <th class="p-3">Rating</th>
            <th class="p-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <% products.forEach(prod => { %>
            <tr id="admin-product-<%= prod.id %>" class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-opacity">
              
              <!-- Product info with thumbnail -->
              <td class="p-3">
                <div class="flex items-center gap-3">
                  <img
                    src="<%= prod.image_url %>"
                    alt="<%= prod.name %>"
                    class="w-10 h-10 rounded-xl object-cover border border-slate-200 dark:border-slate-700 flex-shrink-0"
                    onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&q=80';"
                  />
                  <div>
                    <span class="font-semibold text-slate-900 dark:text-white block max-w-xs truncate"><%= prod.name %></span>
                    <span class="text-[10px] text-slate-400">ID: #<%= prod.id %></span>
                  </div>
                </div>
              </td>

              <td class="p-3">
                <span class="px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[11px] font-medium">
                  <%= prod.category %>
                </span>
              </td>

              <td class="p-3 font-bold text-slate-900 dark:text-white">
                <%= formatPrice(prod.price) %>
              </td>

              <td class="p-3">
                <% if (prod.stock === 0) { %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300">
                    Out of Stock (0)
                  </span>
                <% } else if (prod.stock <= 5) { %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">
                    Low (<%= prod.stock %> left)
                  </span>
                <% } else { %>
                  <span class="font-semibold text-slate-700 dark:text-slate-300">
                    <%= prod.stock %> units
                  </span>
                <% } %>
              </td>

              <td class="p-3">
                <span class="flex items-center gap-1 font-semibold text-amber-600 dark:text-amber-400">
                  <i data-lucide="star" class="w-3 h-3 fill-amber-400"></i>
                  <%= Number(prod.rating || 4.5).toFixed(1) %>
                </span>
              </td>

              <td class="p-3 text-right">
                <div class="inline-flex items-center gap-1.5">
                  <a
                    href="/admin/edit-product/<%= prod.id %>"
                    title="Edit Product"
                    class="p-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-100 transition-colors"
                  >
                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                  </a>

                  <button
                    type="button"
                    title="Delete Product"
                    onclick="deleteProduct(<%= prod.id %>, '<%= prod.name.replace(/'/g, "\\'") %>')"
                    class="p-1.5 rounded-lg bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 hover:bg-rose-100 transition-colors"
                  >
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                  </button>
                </div>
              </td>

            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('partials/footer') %>
