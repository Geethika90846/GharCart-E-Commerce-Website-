<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">

  <!-- Hero Banner -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-indigo-700 via-indigo-600 to-purple-700 text-white shadow-2xl p-6 sm:p-10 lg:p-12">
    <div class="relative z-10 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 backdrop-blur-md text-white text-xs font-semibold uppercase tracking-wider mb-4 border border-white/20">
        <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-300"></i>
        <span>Doorstep Cash on Delivery Available</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
        Discover products you'll love.
      </h1>
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-indigo-100 max-w-xl leading-relaxed">
        Browse curated everyday essentials, electronics, fashion, and home goods with zero online payment risk.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-xs font-semibold text-white/90">
        <div class="flex items-center gap-1.5 bg-black/20 px-3 py-1.5 rounded-xl border border-white/10">
          <i data-lucide="banknote" class="w-4 h-4 text-amber-300"></i>
          <span>Pay after delivery</span>
        </div>
        <div class="flex items-center gap-1.5 bg-black/20 px-3 py-1.5 rounded-xl border border-white/10">
          <i data-lucide="sparkles" class="w-4 h-4 text-amber-300"></i>
          <span>Free shipping over ₹999</span>
        </div>
        <div class="flex items-center gap-1.5 bg-black/20 px-3 py-1.5 rounded-xl border border-white/10">
          <i data-lucide="check-circle" class="w-4 h-4 text-emerald-300"></i>
          <span>Verified quality</span>
        </div>
      </div>
    </div>

    <!-- Decorative background glow -->
    <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-white/10 blur-3xl pointer-events-none"></div>
    <div class="absolute right-12 top-10 w-48 h-48 rounded-full bg-indigo-400/20 blur-2xl pointer-events-none"></div>
  </div>

  <!-- Filters & Controls Bar -->
  <div class="space-y-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      
      <!-- Category Filter Chips -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
        <a
          href="/dashboard?category=All&sort=<%= selectedSort %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>"
          class="px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all <%= selectedCategory === 'All' ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/25' : 'bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:border-indigo-400' %>"
        >
          All Items
        </a>
        <% categories.forEach(cat => { %>
          <a
            href="/dashboard?category=<%= encodeURIComponent(cat) %>&sort=<%= selectedSort %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>"
            class="px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all <%= selectedCategory === cat ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/25' : 'bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:border-indigo-400' %>"
          >
            <%= cat %>
          </a>
        <% }) %>
      </div>

      <!-- Sort & Active Count -->
      <div class="flex items-center gap-3 self-end md:self-auto flex-shrink-0">
        <span class="text-xs text-slate-500 dark:text-slate-400">
          Showing <b><%= products.length %></b> item<%= products.length === 1 ? '' : 's' %>
        </span>

        <div class="relative">
          <select
            onchange="location.href = '/dashboard?category=<%= encodeURIComponent(selectedCategory) %>&search=<%= encodeURIComponent(searchQuery) %>&sort=' + this.value"
            class="text-xs bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 py-2 pl-3 pr-8 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium cursor-pointer shadow-sm"
          >
            <option value="default" <%= selectedSort === 'default' ? 'selected' : '' %>>Latest Products</option>
            <option value="price_asc" <%= selectedSort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
            <option value="price_desc" <%= selectedSort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
            <option value="rating" <%= selectedSort === 'rating' ? 'selected' : '' %>>Highest Rated</option>
          </select>
          <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 absolute right-2.5 top-2.5 pointer-events-none"></i>
        </div>
      </div>

    </div>

    <!-- Active Search indicator -->
    <% if (searchQuery) { %>
      <div class="flex items-center justify-between p-3 rounded-xl bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-100 dark:border-indigo-900/60 text-xs">
        <div class="flex items-center gap-2 text-indigo-900 dark:text-indigo-200">
          <i data-lucide="search" class="w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
          <span>Search results for: "<b><%= searchQuery %></b>"</span>
        </div>
        <a href="/dashboard?category=<%= encodeURIComponent(selectedCategory) %>" class="text-indigo-600 dark:text-indigo-400 font-semibold hover:underline">
          Clear search
        </a>
      </div>
    <% } %>
  </div>

  <!-- Products Grid -->
  <% if (products.length === 0) { %>
    <div class="p-16 text-center bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm my-8">
      <div class="w-16 h-16 mx-auto rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 mb-4">
        <i data-lucide="package-search" class="w-8 h-8"></i>
      </div>
      <h3 class="text-lg font-bold text-slate-900 dark:text-white">No products found</h3>
      <p class="text-sm text-slate-500 dark:text-slate-400 max-w-sm mx-auto mt-1">
        We couldn't find any items matching your selected criteria. Try adjusting your search or category filters.
      </p>
      <div class="mt-6">
        <a href="/dashboard" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 shadow-md shadow-indigo-600/20">
          <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
          <span>Reset Filters</span>
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <% products.forEach(product => { %>
        <div class="product-card group flex flex-col bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">
          
          <!-- Image Container with Link -->
          <a href="/product/<%= product.id %>" class="relative block aspect-square overflow-hidden bg-slate-100 dark:bg-slate-800">
            <img
              src="<%= product.image_url %>"
              alt="<%= product.name %>"
              loading="lazy"
              class="product-card-img w-full h-full object-cover object-center"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&q=80';"
            />

            <!-- Category Pill -->
            <div class="absolute top-3 left-3">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/90 dark:bg-slate-900/90 text-slate-800 dark:text-slate-200 backdrop-blur-md shadow-sm border border-slate-200/50 dark:border-slate-700/50">
                <%= product.category %>
              </span>
            </div>

            <!-- Stock Status Badges -->
            <div class="absolute top-3 right-3 flex flex-col items-end gap-1">
              <% if (product.stock === 0) { %>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-rose-500 text-white shadow-sm">
                  Out of Stock
                </span>
              <% } else if (product.stock <= 5) { %>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500 text-white shadow-sm animate-pulse">
                  Only <%= product.stock %> left!
                </span>
              <% } %>
            </div>

            <!-- Rating Overlay at bottom of image -->
            <div class="absolute bottom-2.5 left-2.5 bg-black/60 backdrop-blur-sm text-white px-2 py-0.5 rounded-md flex items-center gap-1 text-[11px] font-semibold">
              <i data-lucide="star" class="w-3 h-3 text-amber-400 fill-amber-400"></i>
              <span><%= Number(product.rating || 4.5).toFixed(1) %></span>
            </div>
          </a>

          <!-- Details & Add to Cart -->
          <div class="p-4 flex-1 flex flex-col justify-between">
            <div>
              <a href="/product/<%= product.id %>" class="block group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                <h3 class="font-semibold text-sm text-slate-900 dark:text-slate-100 line-clamp-1">
                  <%= product.name %>
                </h3>
              </a>
              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-1 leading-relaxed">
                <%= product.description %>
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2">
              <div>
                <span class="text-xs text-slate-400 block -mb-0.5">Price</span>
                <span class="text-base font-bold text-slate-900 dark:text-white">
                  <%= formatPrice(product.price) %>
                </span>
              </div>

              <% if (product.stock > 0) { %>
                <button
                  type="button"
                  onclick="addToCart(<%= product.id %>, 1, this)"
                  class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 active:scale-95 shadow-md shadow-indigo-600/20 transition-all cursor-pointer"
                >
                  <i data-lucide="shopping-cart" class="w-3.5 h-3.5"></i>
                  <span>Add</span>
                </button>
              <% } else { %>
                <button
                  type="button"
                  disabled
                  class="px-3 py-2 rounded-xl text-xs font-semibold text-slate-400 bg-slate-100 dark:bg-slate-800 cursor-not-allowed"
                >
                  Unavailable
                </button>
              <% } %>
            </div>

          </div>

        </div>
      <% }) %>
    </div>
  <% } %>

</div>

<%- include('partials/footer') %>
