<%- include('partials/header') %>

<div class="min-h-[85vh] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-lg bg-white dark:bg-slate-900 rounded-3xl p-8 sm:p-10 shadow-2xl border border-slate-200/80 dark:border-slate-800 transition-all">
    
    <!-- Header -->
    <div class="text-center mb-8">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-slate-900 to-indigo-900 mx-auto flex items-center justify-center text-white shadow-lg shadow-indigo-500/20 mb-4 border border-indigo-500/30">
        <i data-lucide="shield-plus" class="w-7 h-7 text-indigo-400"></i>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Register Administrator</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Create a new authorized store management account</p>
    </div>

    <!-- Error Alerts -->
    <% if (errors && errors.length > 0) { %>
      <div class="mb-6 p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-sm">
        <div class="flex items-center gap-2 font-semibold mb-1">
          <i data-lucide="alert-circle" class="w-4 h-4"></i>
          <span>Please fix the following:</span>
        </div>
        <ul class="list-disc list-inside space-y-1 text-xs">
          <% errors.forEach(err => { %>
            <li><%= err.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Auto-fill Demo Box -->
    <div class="mb-6 p-4 rounded-2xl bg-indigo-50/70 dark:bg-indigo-950/40 border border-indigo-100 dark:border-indigo-900/60">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-indigo-900 dark:text-indigo-200 flex items-center gap-1.5">
          <i data-lucide="sparkles" class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400"></i>
          Fast Test Auto-fill
        </span>
        <span class="text-[10px] text-indigo-600 dark:text-indigo-400 font-medium">Generates fresh unique details</span>
      </div>
      <p class="text-xs text-indigo-700/80 dark:text-indigo-300/80 leading-relaxed mb-3">
        Click below to auto-fill guaranteed valid unique admin credentials without manual typing:
      </p>
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          onclick="fillAdminDetails()"
          class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-700 text-xs font-semibold hover:bg-indigo-50 transition-colors shadow-sm"
        >
          Auto-fill Details
        </button>
        <button
          type="button"
          onclick="fillAndSubmitAdmin()"
          class="px-3 py-1.5 rounded-xl bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition-colors shadow-sm shadow-indigo-600/20 flex items-center gap-1"
        >
          <i data-lucide="zap" class="w-3 h-3"></i>
          <span>1-Click Auto-Register Admin</span>
        </button>
      </div>
    </div>

    <!-- Registration Form -->
    <form action="/admin/register" method="POST" id="admin-register-form" class="space-y-4">
      <input type="hidden" name="sid" value="<%= typeof sid !== 'undefined' ? sid : '' %>">
      <div>
        <label for="admin_name" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Full Name</label>
        <div class="relative">
          <input
            type="text"
            id="admin_name"
            name="name"
            autocomplete="name"
            required
            value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
            placeholder="Operations Manager"
            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"
          />
          <i data-lucide="user" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="admin_email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Admin Email</label>
          <div class="relative">
            <input
              type="email"
              id="admin_email"
              name="email"
              autocomplete="email"
              required
              value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
              placeholder="manager@shopsphere.com"
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"
            />
            <i data-lucide="mail" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
          </div>
        </div>

        <div>
          <label for="admin_phone" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Phone Number</label>
          <div class="relative">
            <input
              type="tel"
              id="admin_phone"
              name="phone"
              autocomplete="tel"
              required
              value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
              placeholder="9876543210"
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"
            />
            <i data-lucide="phone" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="admin_pwd" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Password</label>
          <div class="relative">
            <input
              type="password"
              id="admin_pwd"
              name="password"
              autocomplete="new-password"
              required
              placeholder="Min 6 characters"
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"
            />
            <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
          </div>
        </div>

        <div>
          <label for="admin_cpwd" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Confirm Password</label>
          <div class="relative">
            <input
              type="password"
              id="admin_cpwd"
              name="confirm_password"
              autocomplete="new-password"
              required
              placeholder="Re-type password"
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all"
            />
            <i data-lucide="check" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
          </div>
        </div>
      </div>

      <div>
        <label for="secret_key" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Admin Passcode</label>
        <div class="relative">
          <input
            type="text"
            id="secret_key"
            name="secret_key"
            required
            value="<%= typeof formData !== 'undefined' && formData.secret_key ? formData.secret_key : 'GharCartAdmin2026' %>"
            placeholder="GharCartAdmin2026"
            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all font-mono"
          />
          <i data-lucide="key" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
        </div>
        <span class="text-[11px] text-slate-400 mt-1 block">Default store key: <code class="font-mono text-indigo-600 dark:text-indigo-400">GharCartAdmin2026</code></span>
      </div>

      <div class="pt-2">
        <button
          type="submit"
          class="w-full py-3 px-4 rounded-xl font-semibold text-sm text-white bg-slate-900 hover:bg-slate-800 dark:bg-indigo-600 dark:hover:bg-indigo-700 active:scale-[0.99] shadow-lg shadow-slate-900/25 transition-all flex items-center justify-center gap-2"
        >
          <i data-lucide="shield" class="w-4 h-4"></i>
          <span>Create Admin Account</span>
        </button>
      </div>
    </form>

    <!-- Links -->
    <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 text-center space-y-2">
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Already an admin?
        <a href="/admin/login" class="font-semibold text-indigo-600 dark:text-indigo-400 hover:underline ml-1">Log in here</a>
      </p>
      <div>
        <a href="/login" class="text-[11px] text-slate-400 hover:text-slate-600 dark:hover:text-slate-300">
          ← Switch to Customer Login
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  // Ensure autofilled password automatically matches confirm_password and secret_key has default
  const admForm = document.getElementById('admin-register-form');
  const admPwd = document.getElementById('admin_pwd');
  const admCpwd = document.getElementById('admin_cpwd');
  const secretKeyInput = document.getElementById('secret_key');

  if (admForm && admPwd && admCpwd) {
    admForm.addEventListener('submit', () => {
      if (admPwd.value && !admCpwd.value) {
        admCpwd.value = admPwd.value;
      }
      if (secretKeyInput && !secretKeyInput.value) {
        secretKeyInput.value = 'GharCartAdmin2026';
      }
    });
  }

  function fillAdminDetails() {
    const randomSuffix = Math.floor(1000 + Math.random() * 9000);
    const nameEl = document.getElementById('admin_name');
    const emailEl = document.getElementById('admin_email');
    const phoneEl = document.getElementById('admin_phone');

    if (nameEl) nameEl.value = 'Store Admin ' + randomSuffix;
    if (emailEl) emailEl.value = 'admin_' + randomSuffix + '@shopsphere.com';
    if (phoneEl) phoneEl.value = '987654' + randomSuffix;
    if (admPwd) admPwd.value = 'Admin@123';
    if (admCpwd) admCpwd.value = 'Admin@123';
    if (secretKeyInput) secretKeyInput.value = 'GharCartAdmin2026';

    try {
      if (typeof showToast === 'function') showToast('Generated fresh unique admin details!', 'info');
    } catch (e) {}
  }

  function fillAndSubmitAdmin() {
    fillAdminDetails();
    setTimeout(() => {
      const form = document.getElementById('admin-register-form');
      if (form) {
        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
        } else {
          form.submit();
        }
      }
    }, 150);
  }
</script>

<%- include('partials/footer') %>
