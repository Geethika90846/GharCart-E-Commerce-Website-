<%- include('partials/header') %>

<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-3xl p-8 sm:p-10 shadow-2xl border border-slate-200/80 dark:border-slate-800 transition-all">
    
    <!-- Logo & Header -->
    <div class="text-center mb-8">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-600 mx-auto flex items-center justify-center text-white shadow-lg shadow-indigo-500/25 mb-4">
        <i data-lucide="shopping-bag" class="w-7 h-7"></i>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Welcome Back</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Sign in to your GharCart customer account</p>
    </div>

    <!-- Error Alerts -->
    <% if (errors && errors.length > 0) { %>
      <div class="mb-6 p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-sm">
        <div class="flex items-center gap-2 font-semibold mb-1">
          <i data-lucide="alert-circle" class="w-4 h-4"></i>
          <span>Please correct the following:</span>
        </div>
        <ul class="list-disc list-inside space-y-1 text-xs">
          <% errors.forEach(err => { %>
            <li><%= err.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Demo Credentials Helper Tile -->
    <div class="mb-6 p-4 rounded-2xl bg-indigo-50/70 dark:bg-indigo-950/40 border border-indigo-100 dark:border-indigo-900/60">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-indigo-900 dark:text-indigo-200 flex items-center gap-1.5">
          <i data-lucide="sparkles" class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400"></i>
          Pre-registered Demo Customer
        </span>
        <span class="text-[10px] text-indigo-600 dark:text-indigo-400 font-medium">Ready to use</span>
      </div>
      <p class="text-xs text-indigo-700/80 dark:text-indigo-300/80 font-mono mb-3">user@shopsphere.com / User@123</p>
      
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          onclick="fillDemoUser()"
          class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-700 text-xs font-semibold hover:bg-indigo-50 transition-colors shadow-sm"
        >
          Auto-fill Details
        </button>
        <a
          href="/quick-login?role=user"
          class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold transition-all shadow-md shadow-indigo-600/25 flex items-center gap-1.5"
        >
          <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-300"></i>
          <span>1-Click Sign In</span>
        </a>
      </div>
    </div>

    <!-- Login Form -->
    <form action="/login" method="POST" id="customer-login-form" class="space-y-5">
      <input type="hidden" name="sid" value="<%= typeof sid !== 'undefined' ? sid : '' %>">
      <div>
        <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">Email Address</label>
        <div class="relative">
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            value="<%= typeof email !== 'undefined' ? email : '' %>"
            placeholder="you@example.com"
            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
          />
          <i data-lucide="mail" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
        </div>
      </div>

      <div>
        <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">Password</label>
        <div class="relative">
          <input
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            required
            placeholder="••••••••"
            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
          />
          <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
        </div>
      </div>

      <button
        type="submit"
        class="w-full py-3 px-4 rounded-xl font-semibold text-sm text-white bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center gap-2"
      >
        <span>Sign In</span>
        <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </button>
    </form>

    <!-- Registration Link -->
    <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 text-center">
      <p class="text-xs text-slate-500 dark:text-slate-400">
        New to GharCart?
        <a href="/register" class="font-semibold text-indigo-600 dark:text-indigo-400 hover:underline ml-1">Create a new customer account</a>
      </p>
      <div class="mt-3">
        <a href="/admin/login" class="text-[11px] text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors">
          Are you a store manager? Go to Admin Portal →
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  function fillDemoUser() {
    document.getElementById('email').value = 'user@shopsphere.com';
    document.getElementById('password').value = 'User@123';
    if (window.showToast) showToast('Filled demo customer credentials!', 'info');
  }

  function fillAndSubmitDemoUser() {
    fillDemoUser();
    setTimeout(() => {
      document.getElementById('customer-login-form').submit();
    }, 200);
  }
</script>

<%- include('partials/footer') %>
