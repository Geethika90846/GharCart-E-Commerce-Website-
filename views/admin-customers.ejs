<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Customer Directory</h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">Manage registered buyers, order histories, and contact info</p>
    </div>
    <a href="/admin/dashboard" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300">
      <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
      <span>Back to Dashboard</span>
    </a>
  </div>

  <!-- Search Filter -->
  <div class="max-w-md">
    <form action="/admin/customers" method="GET" class="relative">
      <input
        type="text"
        name="search"
        placeholder="Search by customer name, email, or phone..."
        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
        class="w-full pl-10 pr-10 py-2.5 text-xs sm:text-sm bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 placeholder-slate-400 rounded-2xl border border-slate-200 dark:border-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm"
      />
      <button type="submit" class="absolute left-3.5 top-3 text-slate-400">
        <i data-lucide="search" class="w-4 h-4"></i>
      </button>
      <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
        <a href="/admin/customers" class="absolute right-3.5 top-3 text-slate-400 hover:text-slate-600">
          <i data-lucide="x" class="w-4 h-4"></i>
        </a>
      <% } %>
    </form>
  </div>

  <!-- Customers Table -->
  <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm space-y-4">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
        Total Registered Customers: <%= customers.length %>
      </span>
    </div>

    <% if (customers.length === 0) { %>
      <div class="p-12 text-center text-sm text-slate-400">
        No customers matching your search query.
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-600 dark:text-slate-300">
          <thead class="bg-slate-50 dark:bg-slate-800/60 uppercase font-semibold text-slate-400 border-b border-slate-200 dark:border-slate-700">
            <tr>
              <th class="p-3">User ID</th>
              <th class="p-3">Customer Name</th>
              <th class="p-3">Contact Email</th>
              <th class="p-3">Phone</th>
              <th class="p-3">Date Joined</th>
              <th class="p-3">Total Orders</th>
              <th class="p-3 text-right">Lifetime Spend</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            <% customers.forEach(cust => { %>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
                <td class="p-3 font-mono font-bold text-indigo-600 dark:text-indigo-400">#<%= cust.id %></td>
                
                <td class="p-3 font-semibold text-slate-900 dark:text-white">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-bold flex items-center justify-center text-xs">
                      <%= cust.name.charAt(0).toUpperCase() %>
                    </div>
                    <span><%= cust.name %></span>
                  </div>
                </td>

                <td class="p-3 font-mono text-slate-600 dark:text-slate-300"><%= cust.email %></td>
                <td class="p-3 text-slate-600 dark:text-slate-300"><%= cust.phone || '—' %></td>
                
                <td class="p-3 text-slate-400">
                  <%= new Date(cust.created_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </td>

                <td class="p-3">
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold <%= cust.order_count > 0 ? 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/50 dark:text-indigo-300' : 'bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400' %>">
                    <%= cust.order_count %> order<%= cust.order_count === 1 ? '' : 's' %>
                  </span>
                </td>

                <td class="p-3 text-right font-bold text-slate-900 dark:text-white">
                  <%= formatPrice(cust.total_spent) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

  </div>

</div>

<%- include('partials/footer') %>
