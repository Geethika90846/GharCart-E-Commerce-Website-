<%- include('partials/header') %>

<div class="min-h-[85vh] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-lg bg-white dark:bg-slate-900 rounded-3xl p-8 sm:p-10 shadow-2xl border border-slate-200/80 dark:border-slate-800 transition-all">
    
    <!-- Header -->
    <div class="text-center mb-8">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-600 mx-auto flex items-center justify-center text-white shadow-lg shadow-indigo-500/25 mb-4">
        <i data-lucide="user-plus" class="w-7 h-7"></i>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Create an Account</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Start shopping with fast Cash on Delivery checkout</p>
    </div>

    <!-- Error Alerts -->
    <% if (errors && errors.length > 0) { %>
      <div class="mb-6 p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-sm">
        <div class="flex items-center gap-2 font-semibold mb-1">
          <i data-lucide="alert-circle" class="w-4 h-4"></i>
          <span>Please correct the errors:</span>
        </div>
        <ul class="list-disc list-inside space-y-1 text-xs">
          <% errors.forEach(err => { %>
            <li><%= err.msg %></li>
          <% }) %>
        </ul>

        <% if (typeof isExistingUser !== 'undefined' && isExistingUser) { %>
          <div class="mt-3 pt-3 border-t border-rose-200 dark:border-rose-800 flex items-center justify-between">
            <span class="text-xs font-semibold">Already registered?</span>
            <a href="/login" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition-colors shadow-sm">
              <i data-lucide="log-in" class="w-3.5 h-3.5"></i>
              <span>Log In Directly</span>
            </a>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- Auto-fill Demo Box -->
    <div class="mb-6 p-4 rounded-2xl bg-indigo-50/70 dark:bg-indigo-950/40 border border-indigo-100 dark:border-indigo-900/60">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-indigo-900 dark:text-indigo-200 flex items-center gap-1.5">
          <i data-lucide="sparkles" class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400"></i>
          Fast Test Auto-fill
        </span>
        <span class="text-[10px] text-indigo-600 dark:text-indigo-400 font-medium">Generates fresh unique customer</span>
      </div>
      <p class="text-xs text-indigo-700/80 dark:text-indigo-300/80 leading-relaxed mb-3">
        Click below to auto-fill guaranteed valid unique details, or register instantly with 1-click:
      </p>
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          onclick="fillCustomerDetails()"
          class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-700 text-xs font-semibold hover:bg-indigo-50 transition-colors shadow-sm"
        >
          Auto-fill Details
        </button>
        <button
          type="button"
          onclick="fillAndSubmitCustomer()"
          class="px-3 py-1.5 rounded-xl bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition-colors shadow-sm shadow-indigo-600/20 flex items-center gap-1"
        >
          <i data-lucide="zap" class="w-3 h-3"></i>
          <span>1-Click Auto-Register</span>
        </button>
      </div>
    </div>

    <!-- Form -->
    <form action="/register" method="POST" id="register-form" class="space-y-4">
      <input type="hidden" name="sid" value="<%= typeof sid !== 'undefined' ? sid : '' %>">
      <div>
        <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Full Name</label>
        <div class="relative">
          <input
            type="text"
            id="name"
            name="name"
            autocomplete="name"
            required
            value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
            placeholder="Rahul Sharma"
            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
          />
          <i data-lucide="user" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Email Address</label>
          <div class="relative">
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              required
              value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
              placeholder="rahul@example.com"
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
            />
            <i data-lucide="mail" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
          </div>
        </div>

        <div>
          <label for="phone" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Mobile Number</label>
          <div class="relative">
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              required
              value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
              placeholder="9876543210"
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
            />
            <i data-lucide="phone" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Password</label>
          <div class="relative">
            <input
              type="password"
              id="password"
              name="password"
              autocomplete="new-password"
              required
              placeholder="Min 6 characters"
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
            />
            <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
          </div>
        </div>

        <div>
          <label for="confirm_password" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Confirm Password</label>
          <div class="relative">
            <input
              type="password"
              id="confirm_password"
              name="confirm_password"
              autocomplete="new-password"
              required
              placeholder="Re-type password"
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
            />
            <i data-lucide="check" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"></i>
          </div>
        </div>
      </div>

      <div class="pt-2">
        <button
          type="submit"
          class="w-full py-3 px-4 rounded-xl font-semibold text-sm text-white bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center gap-2"
        >
          <span>Create Account</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </button>
      </div>
    </form>

    <!-- Link to Login -->
    <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 text-center space-y-2">
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Already registered with GharCart?
        <a href="/login" class="font-semibold text-indigo-600 dark:text-indigo-400 hover:underline ml-1">Log in here</a>
      </p>
      <div>
        <a href="/admin/register" class="text-[11px] text-slate-400 hover:text-slate-600 dark:hover:text-slate-300">
          Want to register an Administrator? Admin Register →
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  // Ensure autofilled password automatically matches confirm_password if omitted by browser managers
  const regForm = document.getElementById('register-form');
  const pwdInput = document.getElementById('password');
  const cpwdInput = document.getElementById('confirm_password');

  if (regForm && pwdInput && cpwdInput) {
    regForm.addEventListener('submit', () => {
      if (pwdInput.value && !cpwdInput.value) {
        cpwdInput.value = pwdInput.value;
      }
    });
  }

  function fillCustomerDetails() {
    const randomSuffix = Math.floor(1000 + Math.random() * 9000);
    const names = ['Priya Sharma', 'Rahul Verma', 'Sneha Patel', 'Amit Nair', 'Rohan Gupta', 'Neha Singh'];
    const chosenName = names[Math.floor(Math.random() * names.length)];

    const nameEl = document.getElementById('name');
    const emailEl = document.getElementById('email');
    const phoneEl = document.getElementById('phone');

    if (nameEl) nameEl.value = chosenName;
    if (emailEl) emailEl.value = 'user_' + randomSuffix + '@example.com';
    if (phoneEl) phoneEl.value = '98' + randomSuffix + '1234';
    if (pwdInput) pwdInput.value = 'Customer@123';
    if (cpwdInput) cpwdInput.value = 'Customer@123';

    try {
      if (typeof showToast === 'function') showToast('Generated fresh customer details!', 'info');
    } catch (e) {}
  }

  function fillAndSubmitCustomer() {
    fillCustomerDetails();
    setTimeout(() => {
      const form = document.getElementById('register-form');
      if (form) {
        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
        } else {
          form.submit();
        }
      }
    }, 150);
  }
</script>

<%- include('partials/footer') %>
