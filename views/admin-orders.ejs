<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Customer Order Management</h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">Update fulfillment progress and notify customers in real-time</p>
    </div>
    <a href="/admin/dashboard" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300">
      <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
      <span>Back to Dashboard</span>
    </a>
  </div>

  <!-- Status Filter Chips -->
  <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
    <% ['All', 'Placed', 'Shipped', 'Delivered', 'Cancelled'].forEach(status => { %>
      <a
        href="/admin/orders?status=<%= status %>"
        class="px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all <%= filterStatus === status ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/25' : 'bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:border-indigo-400' %>"
      >
        <%= status %> (<%= status === 'All' ? orders.length : orders.filter(o => o.status === status).length %>)
      </a>
    <% }) %>
  </div>

  <% if (orders.length === 0) { %>
    <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-8 shadow-sm">
      <div class="w-16 h-16 mx-auto rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 mb-3">
        <i data-lucide="package-search" class="w-8 h-8"></i>
      </div>
      <h3 class="text-base font-bold text-slate-900 dark:text-white">No orders matching "<%= filterStatus %>"</h3>
      <p class="text-xs text-slate-400 mt-1">Try selecting another status tab above.</p>
    </div>
  <% } else { %>
    <div class="space-y-6">
      <% orders.forEach(order => { %>
        <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
          
          <!-- Card Header -->
          <div class="bg-slate-50 dark:bg-slate-800/60 p-4 sm:p-6 border-b border-slate-200/80 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4">
            
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-2xl bg-white dark:bg-slate-700 shadow-sm flex items-center justify-center text-indigo-600 dark:text-indigo-400 font-bold text-sm">
                #<%= order.id %>
              </div>
              <div>
                <h4 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                  <span><%= order.full_name %></span>
                  <span class="text-xs font-normal text-slate-400">(<%= order.phone %>)</span>
                </h4>
                <p class="text-xs text-slate-400"><%= order.customer_email %> • Ordered on <%= new Date(order.created_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
              </div>
            </div>

            <!-- Status Dropdown & Badge -->
            <div class="flex items-center gap-3">
              <span id="status-badge-<%= order.id %>" class="px-3 py-1 text-xs font-bold rounded-full <%= 
                order.status === 'Placed' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300' :
                order.status === 'Shipped' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300' :
                order.status === 'Delivered' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300' :
                'bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-300'
              %>">
                <%= order.status %>
              </span>

              <div class="relative">
                <select
                  data-prev="<%= order.status %>"
                  onchange="updateAdminOrderStatus(<%= order.id %>, this.value, this)"
                  class="text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 py-1.5 pl-3 pr-8 rounded-xl font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer shadow-sm"
                >
                  <option value="Placed" <%= order.status === 'Placed' ? 'selected' : '' %>>Placed</option>
                  <option value="Shipped" <%= order.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                  <option value="Delivered" <%= order.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                  <option value="Cancelled" <%= order.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                </select>
                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 absolute right-2.5 top-2 pointer-events-none"></i>
              </div>
            </div>

          </div>

          <!-- Card Body: Items & Address -->
          <div class="p-4 sm:p-6 space-y-4">
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              
              <!-- Items list (2 cols) -->
              <div class="md:col-span-2 space-y-3">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Package Items</span>
                <% order.items.forEach(item => { %>
                  <div class="flex items-center justify-between text-xs py-1.5 border-b border-slate-100 dark:border-slate-800/80 last:border-b-0">
                    <div class="flex items-center gap-3">
                      <img src="<%= item.image_url %>" alt="" class="w-10 h-10 rounded-lg object-cover border border-slate-200 dark:border-slate-700" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&q=80';" />
                      <div>
                        <span class="font-semibold text-slate-800 dark:text-slate-200 block"><%= item.product_name %></span>
                        <span class="text-slate-400">Qty: <%= item.quantity %> × <%= formatPrice(item.price) %></span>
                      </div>
                    </div>
                    <span class="font-bold text-slate-900 dark:text-white"><%= formatPrice(item.price * item.quantity) %></span>
                  </div>
                <% }) %>
              </div>

              <!-- Shipping Address & Total (1 col) -->
              <div class="bg-slate-50 dark:bg-slate-800/60 p-4 rounded-2xl border border-slate-200/80 dark:border-slate-700/80 space-y-3 text-xs">
                <div>
                  <span class="text-slate-400 font-bold uppercase tracking-wider block text-[10px] mb-1">Destination Address</span>
                  <p class="font-semibold text-slate-800 dark:text-slate-200"><%= order.full_name %></p>
                  <p class="text-slate-500 dark:text-slate-400 leading-relaxed mt-0.5"><%= order.address %>, <%= order.city %> - <%= order.pincode %></p>
                  <p class="text-slate-500 dark:text-slate-400 mt-1">Ph: <span class="font-semibold text-slate-700 dark:text-slate-300"><%= order.phone %></span></p>
                </div>

                <div class="pt-2 border-t border-slate-200 dark:border-slate-700">
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-slate-500">Payment:</span>
                    <span class="font-semibold text-emerald-600 dark:text-emerald-400"><%= order.payment_method %></span>
                  </div>
                  <div class="flex justify-between items-center text-sm font-bold text-slate-900 dark:text-white mt-1">
                    <span>Total Bill:</span>
                    <span class="text-indigo-600 dark:text-indigo-400"><%= formatPrice(order.total) %></span>
                  </div>
                </div>
              </div>

            </div>

          </div>

        </div>
      <% }) %>
    </div>
  <% } %>

</div>

<%- include('partials/footer') %>
